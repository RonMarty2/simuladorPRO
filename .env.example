# Supabase — completar con tus credenciales de proyecto.
# Si dejás esto SIN configurar, la app arranca en MODO LOCAL (sin login, datos
# en el navegador, selector docente/estudiante). Ver local/LEEME.md.
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key-publica

# MODO LOCAL (opcional):
#   VITE_LOCAL_MODE=true   → fuerza modo local aunque haya credenciales.
#   VITE_LOCAL_MODE=false  → fuerza modo online aunque falten credenciales.
#   (sin esta variable) → local automático si no hay VITE_SUPABASE_URL.
VITE_LOCAL_MODE=

# Sentry (OPCIONAL) — monitoreo de errores en producción.
# Si lo dejás vacío, la app funciona igual y Sentry no se activa.
# Para activarlo: crea un proyecto React en https://sentry.io y pega su DSN.
VITE_SENTRY_DSN=
